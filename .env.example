# Copie para .env (nunca versionado) e preencha os valores vazios.

# Banco de dados (PostgreSQL)
POSTGRES_DB=amigosecreto
POSTGRES_USER=amigo
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Chave AES-256 que cifra os pares do sorteio (research R9).
# Gere com: openssl rand -base64 32
# Guarde junto com o backup do banco: sem ela os pares ficam ilegíveis.
DRAW_ENCRYPTION_KEY=

# Porta publicada do frontend (nginx) no host
APP_PORT=8080

# false em ambiente local via http; true em produção (https)
COOKIE_SECURE=false
